{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bo.dev/schemas/bo.package.v1",
  "title": "bo.package.v1 (propus, neratificat)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "packageId", "version", "kind", "publisherId", "keyId",
    "createdAt", "artifactDigests", "dependencies", "compatibility",
    "requestedCapabilities", "signature"
  ],
  "properties": {
    "schemaVersion": {"const": "bo.package.v1"},
    "packageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[a-z0-9.-]{1,32})?$"
    },
    "kind": {"enum": ["bobot", "agent", "workflow"]},
    "publisherId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "keyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "artifactDigests": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {"pattern": "^[A-Za-z0-9._/-]{1,256}$"},
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "dependencies": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "versionRange"],
        "properties": {
          "packageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "versionRange": {
            "type": "string",
            "pattern": "^(>=)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minHost", "maxHost"],
      "properties": {
        "minHost": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "maxHost": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "requestedCapabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9:_-]{1,63}$"}
    },
    "settingsSchemaRef": {"type": "string", "maxLength": 256},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 128}
      }
    }
  }
}
